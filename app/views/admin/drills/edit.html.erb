<div class="page">
  <div class="page-header">
    <h1>Edit Drill</h1>
    <p>Update this drill's information.</p>
    <div class="page-header-actions">
      <%= link_to admin_drill_path(@drill), class: "admin-btn" do %>
        <%= icon("arrow-left", size: 16) %> Back to Drill
      <% end %>
    </div>
  </div>

  <div style="max-width: 700px;">
    <%= render "admin/drills/form", drill: @drill %>
  </div>
</div>
