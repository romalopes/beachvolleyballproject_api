<div class="page">
  <div class="page-header">
    <h1>Edit Skill</h1>
    <p>Update this skill's information.</p>
    <div class="page-header-actions">
      <%= link_to admin_skill_path(@skill), class: "admin-btn" do %>
        <%= icon("arrow-left", size: 16) %> Back to Skill
      <% end %>
    </div>
  </div>

  <div style="max-width: 600px;">
    <%= render "admin/skills/form", skill: @skill %>
  </div>
</div>
