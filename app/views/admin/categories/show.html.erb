<div class="page">
  <div class="page-header">
    <h1>Category</h1>
    <div class="page-header-actions">
      <%= link_to admin_categories_path, class: "admin-btn" do %>
        <%= icon("arrow-left", size: 16) %> Back to Categories
      <% end %>
      <%= link_to edit_admin_category_path(@category), class: "admin-btn admin-btn-edit" do %>
        <%= icon("edit", size: 16) %> Edit
      <% end %>
      <%= button_to "Delete", admin_category_path(@category), method: :delete,
            class: "admin-btn admin-btn-delete",
            data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete \"#{@category.name}\"? This action cannot be undone." } %>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="auth-flash auth-flash-notice"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="auth-flash auth-flash-error"><%= flash[:alert] %></div>
  <% end %>

  <div class="admin-show">
    <div class="admin-show-section">
      <h2><%= @category.name %></h2>
      <p class="admin-show-meta"><%= pluralize(@category.skills.count, "skill") %></p>
    </div>

    <div class="admin-show-section">
      <h3>Details</h3>
      <dl class="admin-details">
        <dt>ID</dt><dd><%= @category.id %></dd>
        <dt>Slug</dt><dd><%= @category.slug %></dd>
        <dt>Created at</dt><dd><%= long_date(@category.created_at) if @category.created_at %></dd>
        <dt>Updated at</dt><dd><%= long_date(@category.updated_at) if @category.updated_at %></dd>
      </dl>
    </div>

    <div class="admin-show-section">
      <h3>Skills in this category</h3>
      <% if @category.skills.empty? %>
        <p class="text-muted">No skills in this category yet.</p>
      <% else %>
        <div class="admin-related-list">
          <% @category.skills.each do |skill| %>
            <div class="admin-related-item">
              <%= link_to admin_skill_path(skill), class: "admin-link" do %>
                <%= skill.title %>
                <%= icon("arrow-right", size: 14) %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
