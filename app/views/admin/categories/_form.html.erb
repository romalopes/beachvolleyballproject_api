<%= form_with model: @category, url: @category.new_record? ? admin_categories_path : admin_category_path(@category),
    class: "admin-form", local: true do |form| %>
  <% if @category.errors.any? %>
    <div class="auth-flash auth-flash-error">
      <h4 style="margin-bottom: 0.5rem;"><%= pluralize(@category.errors.count, "error") %> prevented this category from being saved:</h4>
      <ul style="margin: 0; padding-left: 1.5rem;">
        <% @category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form-section">
    <h3>Basic Information</h3>

    <div class="admin-field">
      <%= form.label :name, "Name", required: true %>
      <%= form.text_field :name, class: "admin-input", placeholder: "e.g. Attack", maxlength: 255 %>
    </div>
  </div>

  <div class="admin-form-actions">
    <%= link_to @category.new_record? ? admin_categories_path : admin_category_path(@category), class: "admin-btn" do %>
      <%= icon("arrow-left", size: 16) %> Back
    <% end %>
    <%= form.submit @category.new_record? ? "Create Category" : "Update Category", class: "admin-btn admin-btn-add" %>
  </div>
<% end %>
