<div class="page">
  <%= render "shared/page_header", title: "Videos", description: "Watch skill demonstrations, drill walkthroughs, and training footage." %>

  <% if @videos.empty? %>
    <%= render "shared/empty_state", title: "No videos available", description: "Videos will appear here when added to the library." %>
  <% else %>
    <div class="video-grid">
      <% @videos.each do |video| %>
        <div class="video-card">
          <div class="video-thumbnail">
            <%= icon("play-circle", size: 24, color: "var(--amber-500)", style: "position: absolute;") %>
          </div>
          <div class="video-info">
            <h4><%= video.title %></h4>
            <p><%= video.asset_type == "example_demo" ? "Example Demo" : "Training Clip" %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
