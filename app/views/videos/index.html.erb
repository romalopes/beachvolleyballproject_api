<div class="page">
  <%= render "shared/page_header", title: "Videos", description: "Watch skill demonstrations, drill walkthroughs, and training footage." %>

  <% if @videos.empty? %>
    <%= render "shared/empty_state", title: "No videos available", description: "Videos will appear here when added to the library." %>
  <% else %>
    <div class="video-grid">
      <% @videos.each do |video| %>
        <div class="video-card">
          <div class="video-thumbnail">
            <% if video.thumbnail_url %>
              <%= image_tag video.thumbnail_url, alt: video.title, style: "width: 100%; height: 100%; object-fit: cover;" %>
            <% else %>
              <%= icon("play-circle", size: 24, color: "var(--amber-500)", style: "position: absolute;") %>
            <% end %>
          </div>
          <div class="video-info">
            <h4><%= video.title.presence || "Untitled video" %></h4>
            <p>
              <%= video.provider_label %>
              <% if video.reference_count > 0 %>
                · used in <%= pluralize(video.reference_count, "place") %>
              <% end %>
            </p>
            <p><%= link_to "Watch on #{video.provider_label} ↗", video.external_url, target: "_blank", rel: "noreferrer noopener" %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
