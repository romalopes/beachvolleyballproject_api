<%= link_to drill_path(drill), class: "card drill-card", data: { filter_target: "item", search: drill.title.to_s.downcase, filter: drill.difficulty_level } do %>
  <h3 class="card-title"><%= drill.title %></h3>
  <% if drill.setup_instructions.present? %>
    <p class="card-description"><%= drill.setup_instructions %></p>
  <% end %>
  <div class="drill-stats">
    <span class="drill-stat">
      <%= icon("users", size: 14) %>
      <%= drill.player_range_label %>
    </span>
    <span class="drill-stat"><%= drill.ideal_label %></span>
    <span class="drill-stat"><%= drill.training_stage_label %></span>
    <span class="difficulty <%= drill.difficulty_level %>">
      <%= drill.difficulty_level %>
    </span>
  </div>
  <div class="card-meta">
    <span class="home-section-link">
      View drill <%= icon("arrow-right", size: 14) %>
    </span>
  </div>
<% end %>
