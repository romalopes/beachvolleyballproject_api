<div class="page" data-controller="filter">
  <%= render "pages/page_header", title: "Drills", description: "Search and filter drills by difficulty and player count. Each drill develops specific skills." %>

  <div class="search-bar">
    <span class="search-bar-icon"><%= icon("search", size: 18) %></span>
    <input type="text" placeholder="Search drills..." data-filter-target="input" data-action="input->filter#apply">
  </div>

  <% difficulties = ["beginner", "intermediate", "advanced"] %>
  <div class="filter-bar">
    <button class="filter-btn active" data-filter-target="button" data-filter-value="all" data-action="filter#select">All Levels</button>
    <% difficulties.each do |level| %>
      <button class="filter-btn" data-filter-target="button" data-filter-value="<%= level %>" data-action="filter#select">
        <%= level.capitalize %>
      </button>
    <% end %>
  </div>

  <% if @drills.empty? %>
    <%= render "pages/empty_state", title: "No drills found", description: "Try adjusting your search or filter." %>
  <% else %>
    <div class="grid">
      <% @drills.each do |drill| %>
        <%= render "pages/drill_card", drill: drill %>
      <% end %>
    </div>
    <div style="display: none" data-filter-target="empty">
      <%= render "pages/empty_state", title: "No drills found", description: "Try adjusting your search or filter." %>
    </div>
  <% end %>
</div>
