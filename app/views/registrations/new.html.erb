<div class="page auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <span class="sidebar-logo-icon">
        <img src="/ball.png" width="28" height="28" alt="" />
      </span>
      BVB Hub
    </div>
    <h2>Create your account</h2>
    <p class="auth-subtitle">Sign up to organise skills, drills and training sessions.</p>
    <%= tag.div(flash[:alert], class: "auth-flash auth-flash-error") if flash[:alert] %>
    <%= form_with model: @user, url: registration_path, class: "auth-form" do |form| %>
      <% if @user.errors.any? %>
        <div class="auth-flash auth-flash-error">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="auth-field">
        <%= label_tag "user[first_name]", "First name" %>
        <%= text_field_tag "user[first_name]", params.dig(:user, :first_name), required: true, autofocus: true, autocomplete: "given-name", placeholder: "First name", maxlength: 50 %>
      </div>
      <div class="auth-field">
        <%= label_tag "user[last_name]", "Last name" %>
        <%= text_field_tag "user[last_name]", params.dig(:user, :last_name), required: true, autocomplete: "family-name", placeholder: "Last name", maxlength: 50 %>
      </div>
      <div class="auth-field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@example.com" %>
      </div>
      <div class="auth-field">
        <%= form.label :password, "Password" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "At least 8 characters", maxlength: 72 %>
      </div>
      <div class="auth-field">
        <%= form.label :password_confirmation, "Confirm password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat your password", maxlength: 72 %>
      </div>
      <%= form.submit "Sign up", class: "auth-submit" %>
    <% end %>
    <div class="auth-links">
      <%= link_to "Already have an account? Sign in", new_session_path %>
    </div>
  </div>
</div>
