<div class="page">
  <div class="detail-header">
    <%= link_to training_path, class: "back-link" do %>
      <%= icon("arrow-left", size: 16) %>
      Back to Training
    <% end %>
    <span class="section-label">Training Session</span>
    <h1><%= @session.title %></h1>
    <div class="tags" style="margin-top: 1rem">
      <%= tag_pill(variant: :primary) { @session.status_label } %>
      <% if @session.location.present? %>
        <%= tag_pill { @session.location } %>
      <% end %>
    </div>
  </div>

  <section class="detail-section">
    <h2>When &amp; Where</h2>
    <p>
      <%= icon("calendar-days", size: 16, style: "margin-right: 0.5rem;") %>
      <strong>Time:</strong> <%= long_date(@session.starts_at) %> &ndash; <%= @session.ends_at.strftime("%H:%M") %>
      (<%= @session.duration_minutes %> minutes)
    </p>
    <% if @session.created_by %>
      <p><strong>Created by:</strong> <%= @session.created_by.name %></p>
    <% end %>
  </section>

  <% if @session.description.present? %>
    <section class="detail-section">
      <h2>Description</h2>
      <p><%= @session.description %></p>
    </section>
  <% end %>

  <section class="detail-section">
    <h2>Training Focuses</h2>
    <% if @focuses.empty? %>
      <p>No focuses recorded.</p>
    <% else %>
      <div class="related-list">
        <% @focuses.each do |focus| %>
          <div class="related-item">
            <span class="related-item-title">
              <%= icon("target", size: 16, style: "margin-right: 0.5rem;") %>
              <%= focus.label %>
            </span>
            <span class="related-item-meta">
              <% if focus.skill_based? && focus.skill&.category %>
                <%= focus.skill.category.name %>
              <% else %>
                Custom focus
              <% end %>
              <% if focus.description.present? %> &middot; <%= focus.description %><% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="detail-section">
    <h2>Drills</h2>
    <% if @session_drills.empty? %>
      <p>No drills selected.</p>
    <% else %>
      <div class="related-list">
        <% @session_drills.each_with_index do |entry, index| %>
          <div class="related-item">
            <span class="related-item-title">
              <%= index + 1 %>.
              <%= link_to entry.drill.title, drill_path(entry.drill) %>
              <% if entry.duration_minutes %> &middot; <%= entry.duration_minutes %> minutes<% end %>
            </span>
            <span class="related-item-meta">
              <% if entry.notes.present? %><%= entry.notes %><% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
