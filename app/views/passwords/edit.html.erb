<div class="page auth-page">
  <div class="auth-card">
    <h2>Choose a new password</h2>
    <p class="auth-subtitle">Enter a new password for your account.</p>

    <%= tag.div(flash[:alert], class: "auth-flash auth-flash-error") if flash[:alert] %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
      <div class="auth-field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "At least 8 characters", maxlength: 72 %>
      </div>
      <div class="auth-field">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>
      </div>
      <%= form.submit "Save new password", class: "auth-submit" %>
    <% end %>
  </div>
</div>

