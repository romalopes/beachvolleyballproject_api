<div class="sidebar-logo">
  <span class="sidebar-logo-icon">
<img src="/ball.png" width="24" height="24" alt="" />
  </span>
  BVB Project - Rails
</div>
<nav class="sidebar-nav">
  <%= link_to root_path, class: "sidebar-link#{' active' if current_page?(root_path)}" do %>
    <%= icon("home") %> Home
  <% end %>
  <%= link_to skills_path, class: "sidebar-link#{' active' if request.path.start_with?('/skills')}" do %>
    <%= icon("target") %> Skills
  <% end %>
  <%= link_to drills_path, class: "sidebar-link#{' active' if request.path.start_with?('/drills')}" do %>
    <%= icon("dumbbell") %> Drills
  <% end %>
  <%= link_to videos_path, class: "sidebar-link#{' active' if current_page?(videos_path)}" do %>
    <%= icon("play-circle") %> Videos
  <% end %>
  <%= link_to training_path, class: "sidebar-link#{' active' if request.path.start_with?('/training')}" do %>
    <%= icon("clipboard-list") %> Training
  <% end %>
  <%= link_to schedule_path, class: "sidebar-link#{' active' if current_page?(schedule_path)}" do %>
    <%= icon("calendar-days") %> Schedule
  <% end %>
  <% if Current.user&.admin? %>
    <%= link_to admin_users_path, class: "sidebar-link#{' active' if request.path.start_with?('/admin')}" do %>
      <%= icon("target") %> Admin
    <% end %>
  <% end %>
</nav>
<div class="sidebar-footer">
  Beach Volleyball Skills Database
  <br />
  Organise. Understand. Train.
</div>
<div class="sidebar-user">
  <% if authenticated? && Current.user %>
    <span class="sidebar-user-email" title="<%= Current.user.email_address %>"><%= Current.user.name.presence || Current.user.email_address %></span>
    <span class="sidebar-user-roles">
      <% Current.user.roles.each do |role| %>
        <span class="role-badge"><%= role.name %></span>
      <% end %>
    </span>
    <%= link_to session_path, data: { turbo_method: :delete } do %>
      <%= icon("arrow-left", size: 14) %> Sign out
    <% end %>
  <% else %>
    <%= link_to new_session_path do %>
      <%= icon("arrow-right", size: 14) %> Sign in
    <% end %>
  <% end %>
</div>
