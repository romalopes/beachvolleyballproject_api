<div class="page">
  <div class="detail-header">
    <%= link_to drills_path, class: "back-link" do %>
      <%= icon("arrow-left", size: 16) %>
      Back to Drills
    <% end %>
    <span class="section-label">Drill</span>
    <h1><%= @drill.title %></h1>
    <div class="tags" style="margin-top: 1rem">
      <%= tag_pill(variant: :primary) { "Drill" } %>
      <% if @drill.difficulty_level.present? %>
        <%= tag_pill(variant: :teal) { @drill.difficulty_level } %>
      <% end %>
      <% if @drill.training_stage_label.present? %>
        <%= tag_pill { @drill.training_stage_label } %>
      <% end %>
      <%# Optional attributes: show only the sides that were provided. %>
      <% if @drill.min_players.present? || @drill.max_players.present? %>
        <%= tag_pill do %>
          <%= icon("users", size: 12, style: "margin-right: 0.25rem;") %>
          <% if @drill.min_players.present? && @drill.max_players.present? %>
            <%= @drill.player_range_label %>
          <% elsif @drill.min_players.present? %>
            Min: <%= @drill.min_players %>
          <% else %>
            Max: <%= @drill.max_players %>
          <% end %>
        <% end %>
      <% end %>
      <% if @drill.ideal_label.present? %>
        <%= tag_pill { @drill.ideal_label } %>
      <% end %>
    </div>
  </div>
  <section class="detail-section">
    <h2>Setup Instructions</h2>
    <p><%= @drill.setup_instructions.presence || "No instructions available." %></p>
  </section>
  <section class="detail-section">
    <h2>Related Skills</h2>
    <% if @drill.skills.empty? %>
      <%= render "shared/empty_state", title: "No skills linked", description: "Skills will appear here when associated with this drill." %>
    <% else %>
      <div class="related-list">
        <% @drill.skills.each do |skill| %>
          <%= link_to skill_path(skill), class: "related-item" do %>
            <span class="related-item-title">
              <%= icon("target", size: 16, style: "margin-right: 0.5rem;") %>
              <%= skill.title %>
            </span>
            <span class="related-item-meta"><%= skill.category&.name %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
